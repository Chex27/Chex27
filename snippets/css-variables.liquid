{%- style -%}
  @font-face {
    font-family: 'Luckiest Guy';
    src: url({{ 'luckiest-guy.woff2' | asset_url }}) format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  :root {
    --color-bg: {{ settings.color_background }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-muted: {{ settings.color_muted }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-text: {{ settings.color_accent_text }};
    --color-border: {{ settings.color_text | color_modify: 'alpha', 0.14 }};
    --color-logo-bg: {{ settings.color_logo_bg }};
    --color-logo-1: {{ settings.color_logo_1 }};
    --color-logo-2: {{ settings.color_logo_2 }};
    --color-logo-3: {{ settings.color_logo_3 }};
    --radius: {{ settings.button_radius }}px;
    --page-width: {{ settings.page_width }}px;
  }
{%- endstyle -%}
