<section class="section page-width narrow account">
  <h1 class="page-title">Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="reset-password">New password</label>
    <input id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
    <label for="reset-confirm">Confirm password</label>
    <input id="reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn btn--accent btn--full" type="submit">Reset password</button>
  {%- endform -%}
</section>
