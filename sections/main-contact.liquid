<section class="section page-width narrow contact">
  <h1 class="page-title">{{ page.title | default: 'Contact' }}</h1>
  {%- if page.content != blank -%}
    <div class="rte muted">{{ page.content }}</div>
  {%- elsif section.settings.intro != blank -%}
    <div class="rte muted">{{ section.settings.intro }}</div>
  {%- endif -%}

  {%- form 'contact', id: 'contact-form', class: 'contact__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">Thanks! We got your message and will get back to you soon.</p>
    {%- else -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <label for="contact-name">Name</label>
      <input id="contact-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      <label for="contact-email">Email</label>
      <input id="contact-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      <label for="contact-order">Order number (if you have one)</label>
      <input id="contact-order" type="text" name="contact[order number]" placeholder="#1001">
      <label for="contact-body">Message</label>
      <textarea id="contact-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      <button type="submit" class="btn btn--accent btn--full btn--lg">Send</button>
    {%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "richtext", "id": "intro", "label": "Text above the form", "default": "<p>Questions about your order, sizing or shipping? Send us a message.</p>", "info": "Text you type on the Contact page in Online Store > Pages replaces this." },
    { "type": "paragraph", "content": "Messages go to your store's contact email (Settings > General)." }
  ]
}
{% endschema %}
