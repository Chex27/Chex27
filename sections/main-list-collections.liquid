<section class="section page-width">
  <h1 class="page-title">Collections</h1>
  <div class="grid grid--3">
    {%- for collection in collections -%}
      <a class="card" href="{{ collection.url }}">
        <div class="card__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', alt: collection.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <div class="card__info"><h2 class="card__title">{{ collection.title }}</h2></div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collections list" }
{% endschema %}
