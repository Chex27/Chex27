<article class="section page-width narrow">
  <p class="eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</p>
  <h1 class="page-title">{{ article.title }}</h1>
  {%- if article.image -%}
    <div class="article__image">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', sizes: '(min-width: 990px) 800px, 100vw', alt: article.title }}</div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="link-arrow" href="{{ blog.url }}">Back to {{ blog.title }}</a></p>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
