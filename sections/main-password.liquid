<section class="password">
  <div class="password__inner">
    {% render 'brand-logo', width: 340, class: 'password__logo' %}

    {%- if section.settings.heading != blank -%}
      <h1 class="password__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p class="muted">{{ shop.password_message }}</p>
    {%- endif -%}

    {% render 'countdown', date: section.settings.drop_date, done_text: section.settings.drop_live_text %}
    {% render 'newsletter-form', form_id: 'password-signup' %}
    {% render 'social-icons' %}

    <details class="password__owner">
      <summary>Enter with password</summary>
      {%- form 'storefront_password' -%}
        <div class="newsletter__row">
          <label class="visually-hidden" for="password">Password</label>
          <input id="password" type="password" name="password" placeholder="Password" autocomplete="current-password" required>
          <button type="submit" class="btn btn--outline">Enter</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="muted small">Are you the store owner? <a href="/admin">Log in here</a></p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Coming soon page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "DROP 001 IS COMING" },
    { "type": "text", "id": "drop_date", "label": "Drop date and time", "info": "Format: 2026-10-17T18:00:00-05:00. Leave blank to hide the countdown." },
    { "type": "text", "id": "drop_live_text", "label": "Text when the countdown ends", "default": "THE DROP IS LIVE" },
    { "type": "paragraph", "content": "The message under the heading is set in Online Store > Preferences > Password protection." }
  ]
}
{% endschema %}
