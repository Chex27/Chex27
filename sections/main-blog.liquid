{%- paginate blog.articles by 12 -%}
  <section class="section page-width">
    <h1 class="page-title">{{ blog.title }}</h1>
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          {%- if article.image -%}
            <div class="card__media">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}</div>
          {%- endif -%}
          <div class="card__info">
            <h2 class="card__title">{{ article.title }}</h2>
            <span class="muted">{{ article.published_at | date: '%b %d, %Y' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
