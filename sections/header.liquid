<header class="header">
  <div class="header__inner page-width">
    <button class="header__toggle" type="button" aria-label="Menu" aria-expanded="false" data-menu-toggle>
      <span></span><span></span>
    </button>

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_style = 'max-width: ' | append: section.settings.logo_width | append: 'px' -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            widths: '200, 400',
            sizes: '200px',
            style: logo_style,
            alt: shop.name
        }}
      {%- else -%}
        <span class="wordmark">{{ section.settings.wordmark | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" data-menu>
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="header__icon" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2"/></svg>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__icon header__cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l-1 13H6L5 7z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 7a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 50, "max": 300, "step": 10, "unit": "px", "default": 120 },
    { "type": "text", "id": "wordmark", "label": "Text logo (used when no logo image)", "default": "WDH" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
