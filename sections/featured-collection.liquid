<section class="section page-width">
  <div class="section__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.collection != blank -%}
      <a class="link-arrow" href="{{ section.settings.collection.url }}">View all</a>
    {%- endif -%}
  </div>
  <div class="grid grid--{{ section.settings.columns }}">
    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.columns) -%}
        {% render 'product-card', product: blank %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The drop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
