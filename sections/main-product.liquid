{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="product page-width" data-product-section data-update-url>
  <div class="product__media">
    {%- for media in product.media -%}
      <div class="product__media-item">
        {%- if media.media_type == 'image' -%}
          {%- liquid
            if forloop.first
              assign loading = 'eager'
            else
              assign loading = 'lazy'
            endif
          -%}
          {{
            media
            | image_url: width: 1600
            | image_tag:
              widths: '550, 800, 1100, 1600',
              sizes: '(min-width: 990px) 55vw, 100vw',
              loading: loading,
              alt: media.alt
          }}
        {%- else -%}
          {{ media | media_tag }}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="product__media-item">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
    {%- endfor -%}
  </div>

  <div class="product__info">
    <div class="product__sticky">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="eyebrow">{{ product.vendor | escape }}</p>
      {%- endif -%}
      <h1 class="product__title">{{ product.title }}</h1>
      <div class="product__price" data-price>
        {% render 'price', product: product, variant: current_variant %}
      </div>

      {% render 'product-form', product: product, current_variant: current_variant, section: section, show_dynamic_checkout: section.settings.show_dynamic_checkout %}

      {%- if product.description != blank -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Buy it now / Shop Pay button", "default": true }
  ]
}
{% endschema %}
