<section class="section page-width">
  <h1 class="page-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter__row search-form">
    <label class="visually-hidden" for="q">Search</label>
    <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
    <input type="hidden" name="type" value="product">
    <button class="btn btn--accent" type="submit">Search</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <p class="muted">{{ search.results_count }} results for "{{ search.terms | escape }}"</p>
        <div class="grid grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a class="card" href="{{ item.url }}"><div class="card__info"><h2 class="card__title">{{ item.title }}</h2></div></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- else -%}
        <p class="muted">No results for "{{ search.terms | escape }}".</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search" }
{% endschema %}
