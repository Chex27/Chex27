<section class="hero hero--{{ section.settings.height }}{% if section.settings.image != blank %} hero--has-image{% endif %}" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}
  <div class="hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="hero__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {% render 'countdown', date: section.settings.drop_date, done_text: section.settings.drop_live_text %}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--accent btn--lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero / drop banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay", "label": "Image darkness", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },
    { "type": "select", "id": "height", "label": "Height", "default": "full", "options": [
      { "value": "medium", "label": "Medium" },
      { "value": "full", "label": "Full screen" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Drop 001" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "WHAT'D HECK" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The first WDH drop is almost here.</p>" },
    { "type": "header", "content": "Drop countdown" },
    { "type": "text", "id": "drop_date", "label": "Drop date and time", "info": "Format: 2026-10-17T18:00:00-05:00 (the -05:00 is your time zone; -05:00 = US Central daylight time). Leave blank to hide the countdown." },
    { "type": "text", "id": "drop_live_text", "label": "Text when the countdown ends", "default": "THE DROP IS LIVE" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero / drop banner" }]
}
{% endschema %}
