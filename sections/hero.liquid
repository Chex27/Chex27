<section class="hero">
  <div class="hero__inner page-width">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_logo -%}
        <h1 class="hero__logo">{% render 'brand-logo', width: 520 %}</h1>
      {%- elsif section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {% render 'countdown', date: section.settings.drop_date, done_text: section.settings.drop_live_text %}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--accent btn--lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="hero__media">
      <span class="hero__sticker">{{ section.settings.sticker | escape }}</span>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 45vw, 100vw', fetchpriority: 'high', alt: section.settings.image.alt
        }}
      {%- else -%}
        <img src="{{ 'wdh-worn.jpg' | asset_url }}" alt="Wearing the WDH 001 hoodie, washed gray with the embroidered drip logo" width="900" height="1125" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero / drop banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the 001 hoodie photo." },
    { "type": "text", "id": "sticker", "label": "Sticker on image", "default": "001" },
    { "type": "text", "id": "eyebrow", "label": "Small text above logo", "default": "Drop 001" },
    { "type": "checkbox", "id": "show_logo", "label": "Show logo as heading", "default": true },
    { "type": "text", "id": "heading", "label": "Text heading (when logo is off)", "default": "WDH" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The first WDH drop. One heavy hoodie, a few tees.</p>" },
    { "type": "header", "content": "Drop countdown" },
    { "type": "text", "id": "drop_date", "label": "Drop date and time", "info": "Format: 2026-10-17T18:00:00-05:00 (the -05:00 is your time zone; -05:00 = US Central daylight time). Leave blank to hide the countdown." },
    { "type": "text", "id": "drop_live_text", "label": "Text when the countdown ends", "default": "DROP 001 IS LIVE" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero / drop banner" }]
}
{% endschema %}
