<section class="section page-width split{% if section.settings.image_right %} split--reverse{% endif %}">
  <div class="split__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="split__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_right", "label": "Put image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "About" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What is WDH?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>WDH is short for What'd Heck. Tell your story here: why you started it and what it's about.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
