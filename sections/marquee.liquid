{%- if section.settings.text != blank -%}
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {%- for i in (1..8) -%}
        <span>{{ section.settings.text | escape }}</span><span class="marquee__dot">&#9679;</span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "WHAT'D HECK" }
  ],
  "presets": [{ "name": "Scrolling text" }]
}
{% endschema %}
